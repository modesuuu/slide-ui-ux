footer .o{opacity:.65}

/* ---------- research methodology (journey path, pattern from white-desert flight path) ---------- */
#home-research{background:var(--home-paper);color:var(--home-ink);position:relative;padding:clamp(64px,7vw,110px) var(--gutter) clamp(56px,6vw,96px);overflow:clip}
.jHead{position:relative;max-width:1320px;margin:0 auto clamp(30px,3vw,54px)}
.jEyebrow{font-size:17px;color:var(--home-muted)}
.jTitle{position:relative;z-index:1;font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:clamp(46px,6vw,96px);line-height:.98;letter-spacing:-.03em;margin-top:14px;color:var(--home-ink)}
.jTitle em{font-family:Georgia,"Times New Roman",serif;font-style:italic;font-weight:400;color:#2878f0;letter-spacing:-.01em}
.jEnding{position:relative;display:inline-block}
.jUnderline{position:absolute;left:0;bottom:-.16em;width:100%;height:.26em}
.jRule{height:1px;background:var(--home-rule);margin-top:clamp(26px,3vw,44px)}
.jGhost{position:absolute;right:-6px;top:-40px;font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:clamp(120px,15vw,230px);line-height:1;color:rgb(19 19 19/.05);pointer-events:none}
.jStage{position:relative;max-width:1320px;height:2400px;margin:0 auto}
.jRoute{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.jTrack{fill:none;stroke:rgb(19 19 19/.13);stroke-width:2}
.jFlown{fill:none;stroke:#131313;stroke-width:2.2;stroke-linecap:round;stroke-dasharray:0px,999999px}
.jEndDot{fill:#131313}
.jDot{position:absolute;z-index:6;width:15px;height:15px;margin:-7.5px 0 0 -7.5px;border-radius:50%;background:#131313;box-shadow:0 0 0 3px var(--home-paper),0 2px 10px rgb(19 19 19/.3);left:50%;top:.9%}
.jDot span{position:absolute;inset:0;border-radius:50%;border:1.5px solid rgb(19 19 19/.45);animation:jPulse 2.6s cubic-bezier(.2,.6,.35,1) infinite}
.jDot span:nth-child(2){animation-delay:.85s}
.jDot span:nth-child(3){animation-delay:1.7s}
@keyframes jPulse{0%{transform:scale(.55);opacity:.9}70%{transform:scale(3.1);opacity:0}100%{transform:scale(3.1);opacity:0}}
.jStop{position:absolute;inset:0;pointer-events:none}
.jNode{position:absolute;z-index:5;width:16px;height:16px;transform:translate(-50%,-50%);border-radius:50%;background:var(--home-paper);border:2.5px solid #131313;transition:background .6s ease,border-color .6s ease,box-shadow .6s ease,scale .6s cubic-bezier(.16,1,.3,1)}
.jStop.lit .jNode{background:var(--sc);border-color:var(--sc);box-shadow:0 4px 16px rgb(19 19 19/.22);scale:1.3}
.jStopHead{position:absolute;opacity:0;transform:translateY(14px);transition:opacity .8s ease,transform .8s cubic-bezier(.16,1,.3,1)}
.jStopKicker{font-family:Georgia,"Times New Roman",serif;font-style:italic;font-size:17px;color:var(--home-muted)}
.jStopName{font-family:"Bricolage Grotesque",sans-serif;font-weight:700;font-size:25px;letter-spacing:.12em;text-transform:uppercase;margin-top:3px;color:var(--home-ink)}
.jDoodleWrap{position:absolute;width:52px;height:52px}
.jDoodleWrap :global(svg){width:100%;height:100%;display:block;overflow:visible}
.jDoodleWrap :global(path){stroke:currentColor}
.jDoodleWrap :global(.jDoodleStar path){fill:currentColor;stroke:#131313;stroke-width:1.6}
.jCard{position:absolute;width:352px;background:#fff;border-radius:18px;padding:26px 28px 16px;box-shadow:0 0 0 1px rgb(0 0 0/.06),0 1px 1px -.5px rgb(0 0 0/.06),0 3px 3px -1.5px rgb(0 0 0/.06),0 6px 6px -3px rgb(0 0 0/.06),0 12px 12px -6px rgb(0 0 0/.06),0 24px 24px -12px rgb(0 0 0/.06);opacity:0;transform:translateY(26px);transition:opacity .9s ease,transform .9s cubic-bezier(.16,1,.3,1)}
.jCardLabel{font-family:Georgia,"Times New Roman",serif;font-style:italic;font-size:17px;color:var(--home-muted)}
.jCard ul{list-style:none;margin-top:6px}
.jCard li{font-size:16.5px;line-height:1.5;color:#2a2a26;padding:11px 0 11px 16px;position:relative;border-top:1px dotted var(--home-rule)}
.jCard li::before{content:"";position:absolute;left:0;top:20px;width:6px;height:6px;background:var(--sc)}
.jImg{position:absolute;width:322px;opacity:0;transform:translateY(26px);transition:opacity .9s ease .12s,transform .9s cubic-bezier(.16,1,.3,1) .12s}
.jImg img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:16px;border:1px solid var(--home-rule);display:block}
.jStop.on .jStopHead,.jStop.on .jCard,.jStop.on .jImg{opacity:1;transform:none}
.jStop--1 .jStopHead{left:49.5%;top:6.4%}
.jStop--1 .jDoodleWrap{left:-8px;top:-60px}
.jStop--1 .jCard{right:3.2%;top:3.2%}
.jStop--1 .jImg{left:2.6%;top:15.5%}
.jStop--2 .jStopHead{left:33%;top:31.6%;width:230px;text-align:right}
.jStop--2 .jDoodleWrap{right:-8px;top:-60px}
.jStop--2 .jCard{left:3.2%;top:28.6%}
.jStop--2 .jImg{right:2.6%;top:41.5%}
.jStop--3 .jStopHead{left:3.2%;top:56.8%}
.jStop--3 .jDoodleWrap{left:-8px;top:-60px}
.jStop--3 .jCard{right:3.2%;top:54.3%}
.jStop--3 .jImg{left:2.6%;top:66.5%}
.jStop--4 .jStopHead{left:34%;top:82.4%;width:230px;text-align:right}
.jStop--4 .jDoodleWrap{right:-8px;top:-60px}
.jStop--4 .jCard{left:3.2%;top:79.3%}
.jStop--4 .jImg{right:2.6%;top:88.3%}
@media (max-width:900px){
  .jStage{height:auto;display:flex;flex-direction:column;gap:64px}
  .jRoute,.jDot,.jGhost,.jNode,.jDoodleWrap{display:none}
  .jStop{position:relative;inset:auto;display:flex;flex-direction:column;gap:20px}
  .jStopHead,.jCard,.jImg{position:relative;left:auto!important;right:auto!important;top:auto!important;text-align:left!important;opacity:1;transform:none}
  .jCard{width:100%}
  .jImg{width:min(322px,100%)}
}
@media (prefers-reduced-motion: reduce){
  .jFlown{stroke-dasharray:none!important}
  .jDot{display:none}
  .jStop .jNode{background:var(--sc);border-color:var(--sc)}
  .jStop .jStopHead,.jStop .jCard,.jStop .jImg{opacity:1;transform:none}
}

/* ---------- insights reel: base + text centered inside the card ---------- */
#home-insights{background:var(--home-paper);color:var(--home-ink);position:relative}
.reelWork .posterCenter{align-items:center;justify-content:center}

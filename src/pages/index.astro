/* ---------- explore ---------- */
#home-explore{background:var(--home-paper);padding:110px var(--gutter) 140px;text-align:center}
#home-explore small{display:block;font-family:"IBM Plex Mono",monospace;font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;opacity:.55;margin-bottom:14px}

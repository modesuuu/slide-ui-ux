.reelWork .poster b{color:#fff;font-size:clamp(17px,2vw,27px);font-weight:800;line-height:1.12;position:relative;z-index:2;text-shadow:0 2px 14px rgb(0 0 0/.3)}
.reelCaption{position:absolute;left:0;top:calc(100% + 22px);width:100%;display:flex;justify-content:space-between;align-items:flex-start;gap:24px;text-align:left;pointer-events:none}
.reelCaption h3{font-family:"Bricolage Grotesque",sans-serif;font-size:clamp(23px,2.5vw,38px);font-weight:500;letter-spacing:-.045em;line-height:1.13;max-width:32ch}

.usersStar{position:absolute;right:6%;top:0;width:46px;height:auto;z-index:35;pointer-events:none}
.uPos1{left:0;top:17%;transform:translate(38%,14%) rotate(-6deg);z-index:10}
.uPos2{left:calc(50% - 186px);top:5%;transform:translate(-8%,7%) rotate(-4deg);z-index:20}

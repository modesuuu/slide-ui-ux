<script>
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";
import Lenis from "lenis";

gsap.registerPlugin(ScrollTrigger);
const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
const TRIAD = ["#2878f0", "#ff7415", "#8060f5"];

/* ---------- Lenis + ScrollTrigger (same wiring as the original) ---------- */
let lenis = null;
if (!reduced) {
  lenis = new Lenis({ lerp: 0.1, smoothWheel: true });
  lenis.on("scroll", ScrollTrigger.update);
  gsap.ticker.add((t) => lenis.raf(t * 1000));
  gsap.ticker.lagSmoothing(0);
}
document.querySelectorAll('a[href^="#"]').forEach((a) => {
  a.addEventListener("click", (e) => {
    const id = a.getAttribute("href");
    if (id.length > 1 && document.querySelector(id)) {
      e.preventDefault();
      if (lenis) lenis.scrollTo(id, { offset: 0, duration: 1.4 });
      else document.querySelector(id).scrollIntoView({ behavior: "smooth" });
    }
  });
});

/* ---------- visibility gate (IntersectionObserver + tab hidden) ---------- */
function makeGate(el, cb, threshold = 0) {
  let visible = false;
  const update = () => cb(visible && !document.hidden);
  new IntersectionObserver(([en]) => { visible = en.isIntersecting; update(); }, { threshold }).observe(el);
  document.addEventListener("visibilitychange", update);
  return update;
}

/* ---------- preloader: iris reveal ---------- */
const heroEl = document.getElementById("hero");
let heroActive = false;
function boot() {
  const pre = document.getElementById("preloader");
  if (reduced || !pre) { pre?.remove(); heroActive = true; heroEl.dataset.motion = "active"; startHeroMotion(); return; }
  const tl = gsap.timeline({ onComplete: () => { pre.remove(); heroEl.dataset.motion = "active"; } });
  tl.to(pre.querySelector(".bootCircle"), { scale: 1.06, duration: 0.5, ease: "power2.out" }, 0.55)
    .to(pre, { clipPath: "circle(0% at 50% 50%)", duration: 1.05, ease: "power3.inOut" }, 0.75)
    .add(() => { heroActive = true; startHeroMotion(); }, 1.15);
}
if (document.readyState === "complete") setTimeout(boot, 350);
else window.addEventListener("load", () => setTimeout(boot, 350));

/* ---------- generic home reveal system (values from the inspection) ---------- */
if (!reduced) {
  const mm = gsap.matchMedia();
  mm.add(
    { desktop: "(min-width: 1024px)", mobile: "(max-width: 1023px)", noPref: "(prefers-reduced-motion: no-preference)" },
    ({ conditions }) => {
      if (!conditions.noPref) return;
      const dist = conditions.desktop ? 48 : 24;
      const scrub = conditions.desktop ? 0.6 : 0.25;
      gsap.utils.toArray("[data-home-primary]").forEach((el, i) => {
        gsap.fromTo(el, { y: dist }, {
          y: 0, ease: "power3.out",
          scrollTrigger: { id: `home-heading-${i}`, trigger: el, start: "top 94%", end: "top 48%", scrub, invalidateOnRefresh: true },
        });
      });
      gsap.utils.toArray("[data-home-secondary]").forEach((el, i) => {
        gsap.fromTo(el, { y: 0.4 * dist }, {
          y: 0, ease: "power2.out",
          scrollTrigger: { id: `home-detail-${i}`, trigger: el, start: "top 96%", end: "top 72%", scrub: 0.25 },
        });
      });
      gsap.utils.toArray('[data-home-sketch="draw"]').forEach((svg) => {
        const paths = svg.querySelectorAll("path");
        paths.forEach((p) => { const L = p.getTotalLength() + 1; gsap.set(p, { strokeDasharray: L, strokeDashoffset: L }); });
        gsap.to(paths, {
          strokeDashoffset: 0, ease: "none", stagger: 0.06,
          scrollTrigger: { id: "home-sketch-draw", trigger: svg.parentElement, start: "top 86%", end: "top 36%", scrub },
        });
      });
      gsap.utils.toArray('[data-home-sketch="rotate"]').forEach((el) => {
        gsap.fromTo(el, { rotation: -24 }, {
          rotation: 36, ease: "none",
          scrollTrigger: { id: "home-sketch-rotate", trigger: el.parentElement, start: "top bottom", end: "bottom top", scrub },
        });
      });
      gsap.utils.toArray("[data-home-drift]").forEach((el, i) => {
        gsap.fromTo(el, { y: -0.6 * dist }, {
          y: 0.6 * dist, ease: "none",
          scrollTrigger: { id: `home-drift-${i}`, trigger: el.parentElement, start: "top bottom", end: "bottom top", scrub },
        });
      });
    }
  );
}
</script>

<script>
import gsap from "gsap";
/* ================= HERO — orbital engine (values verbatim from inspection) ================= */
const SETTINGS = {
  orbit: { duration: 160, radiusX: 0.39, radiusY: 0.35, angle: -7, hoverSpeed: 0, parallax: 44, startPhase: 0.05, clusterStrength: 0.42, clusterAngle: 235 },
  depth: { scaleMin: 0.54, scaleMax: 1.2, focalAngle: 55 },
  sketches: { drawDuration: 1.25, motionAmount: 1 },
  wordmark: { roughness: 6, duration: 1.1, intervalMin: 4, intervalMax: 9 },
};
const stage = document.getElementById("orbitStage");
const heroEl2 = document.getElementById("hero");
const reduced2 = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
const cards = [...stage.querySelectorAll("[data-orbit-card]")];
const identity = stage.querySelector("[data-hero-identity]");
const planes = [...stage.querySelectorAll("[data-sketch-plane]")];
const state = { phase: SETTINGS.orbit.startPhase };
const par = { x: 0, y: 0 };
let metrics = null, orbitTween = null, heroStarted = false, heroVisible = false;
const activeCards = new Set(), focusedCards = new Set();

const warp = (p) => { const n = p * Math.PI * 2; return n - Math.min(0.8, SETTINGS.orbit.clusterStrength) * Math.sin(n - SETTINGS.orbit.clusterAngle * Math.PI / 180); };
const focal = (u) => (1 + Math.cos(u - SETTINGS.depth.focalAngle * Math.PI / 180)) / 2;
const depthScale = (f) => SETTINGS.depth.scaleMin + Math.pow(f, 1.15) * (SETTINGS.depth.scaleMax - SETTINGS.depth.scaleMin) + (window.innerWidth >= 1024 ? 0.24 : 0) * Math.pow(f, 3);

function measure() {
  const w = stage.clientWidth, h = stage.clientHeight, mobile = w < 780;
  const cardW = Math.max(...cards.filter((c) => getComputedStyle(c).display !== "none").map((c) => c.offsetWidth));
  const half = (cardW * SETTINGS.depth.scaleMax) / 2;
  const tilt = mobile ? -0.06 : Math.tan((SETTINGS.orbit.angle * Math.PI) / 180);
  const rx = mobile ? 0.57 * w : Math.min(w * SETTINGS.orbit.radiusX, w / 2 - half - 28);
  const ryCap = Math.sqrt(Math.max(1600, Math.max(40, h / 2 - half / 1.6 - 16) ** 2 - (rx * tilt) ** 2));
  metrics = { w, h, mobile, tilt, rx: Math.max(40, rx), ry: Math.max(40, Math.min(h * (mobile ? 0.34 : SETTINGS.orbit.radiusY), ryCap)), parScale: mobile ? 1 : cardW / 280 };
  layout();
}
function layout() {
  if (!metrics) return;
  const { w, h, rx, ry, tilt } = metrics;
  cards.forEach((node, i) => {
    const u = warp(state.phase + i / cards.length);
    const f = focal(u), s = depthScale(f);
    const x = w / 2 + Math.cos(u) * rx + par.x * (1.2 * f - 0.25);
    const y = h / 2 + Math.sin(u) * ry + Math.cos(u) * rx * tilt + par.y * (1.2 * f - 0.25);
    node.style.transform = `translate3d(${x.toFixed(2)}px,${y.toFixed(2)}px,0) translate(-50%,-50%) scale(${s.toFixed(4)}) rotate(${Number(node.dataset.tilt) + 1.8 * Math.sin(u)}deg) perspective(1100px) rotateX(${(-3 * Math.sin(u)).toFixed(3)}deg) rotateY(${(6 * Math.cos(u)).toFixed(3)}deg)`;
    node.style.zIndex = String(10 + Math.round(10 * f));
    node.style.setProperty("--card-depth", f.toFixed(2));
  });
  if (identity) identity.style.translate = `${-0.16 * par.x}px ${-0.16 * par.y}px`;
  planes.forEach((p) => (p.style.translate = `${0.3 * par.x}px ${0.3 * par.y}px`));
}
function updateActivity() {
  if (!orbitTween) return;
  const foc = focusedCards.size > 0, hov = activeCards.size > 0;
  if (foc) { gsap.killTweensOf(orbitTween); orbitTween.timeScale(0); }
  else gsap.to(orbitTween, { timeScale: hov ? SETTINGS.orbit.hoverSpeed : 1, duration: hov ? 0.3 : 0.85, ease: "power3.out", overwrite: true });
}
cards.forEach((c, i) => {
  c.addEventListener("pointerenter", () => { activeCards.add(i); updateActivity(); });
  c.addEventListener("pointerleave", () => { activeCards.delete(i); updateActivity(); });
  c.addEventListener("focusin", () => { focusedCards.add(i); updateActivity(); });
  c.addEventListener("focusout", () => { focusedCards.delete(i); updateActivity(); });
});
stage.addEventListener("pointermove", (e) => {
  if (e.pointerType !== "mouse" || !metrics || !heroVisible) return;
  const r = stage.getBoundingClientRect(), s = SETTINGS.orbit.parallax * metrics.parScale;
  gsap.to(par, { x: ((e.clientX - r.left) / r.width - 0.5) * s, y: ((e.clientY - r.top) / r.height - 0.5) * s * 0.65, duration: 1.2, ease: "power3.out", overwrite: true, onUpdate: layout });
});
stage.addEventListener("pointerleave", () => gsap.to(par, { x: 0, y: 0, duration: 1.4, ease: "power3.out", overwrite: true, onUpdate: layout }));
new ResizeObserver(measure).observe(stage);

/* wordmark paper-wobble timeline */
function buildWordmark() {
  const wm = document.getElementById("wordmark"), disp = document.getElementById("paperDisp"), noise = document.getElementById("paperNoise");
  const { roughness: r, duration: t, intervalMin: a, intervalMax: b } = SETTINGS.wordmark, L = t / 1.1;

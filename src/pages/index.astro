.iaZonePriv{grid-column:2/4}
.iaGhost{position:absolute;top:34%;right:-1%;font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:clamp(110px,16vw,230px);line-height:1;letter-spacing:-.02em;color:var(--home-ink);opacity:.045;pointer-events:none}

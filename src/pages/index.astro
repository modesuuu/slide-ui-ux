.iaPlace--paper{background:#fff;color:var(--home-ink);box-shadow:0 0 0 1px rgb(0 0 0/.06),0 1px 1px -.5px rgb(0 0 0/.06),0 3px 3px -1.5px rgb(0 0 0/.06),0 6px 6px -3px rgb(0 0 0/.06),0 12px 12px -6px rgb(0 0 0/.06),0 24px 24px -12px rgb(0 0 0/.06)}
.iaPlace--ink{background:#131313;color:#f2f0e2;box-shadow:0 2.8px 2.2px rgb(0 0 0/.034),0 6.7px 5.3px rgb(0 0 0/.048),0 12.5px 10px rgb(0 0 0/.06),0 22.3px 17.9px rgb(0 0 0/.072),0 41.8px 33.4px rgb(0 0 0/.086),0 100px 80px rgb(0 0 0/.12)}

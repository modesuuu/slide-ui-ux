/* ---------- information architecture opener (original composition: three places on one street) ---------- */
#home-ia{background:var(--home-paper);color:var(--home-ink);position:relative;padding:clamp(76px,8vw,124px) var(--gutter) clamp(88px,9vw,136px);overflow:clip}

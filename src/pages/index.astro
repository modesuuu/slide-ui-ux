/* ---------- featured / reel ---------- */
#home-featured{background:var(--home-paper);color:var(--home-ink);position:relative}
.galHeader{display:flex;justify-content:space-between;align-items:center;padding:0 var(--gutter);position:absolute;top:clamp(28px,5.5vh,60px);left:0;right:0;z-index:5;pointer-events:none}
.galHeader a{pointer-events:auto}
.galHeading{font-family:"Bricolage Grotesque",sans-serif;font-size:clamp(22px,2.15vw,34px);font-weight:500;letter-spacing:-.045em;line-height:1.05;position:relative}
.bigWord{position:absolute;top:12.5%;left:6%;right:6%;display:flex;z-index:0;pointer-events:none;color:var(--home-ink)}
.bigWord span{flex:1 1;text-align:center;font-family:"Bricolage Grotesque",sans-serif;font-weight:400;font-size:min(11vh,10vw);line-height:1;opacity:.075;transform-origin:50% 70%;will-change:transform}
.bigWord span.sp{flex:.45 1}
.galMeta{display:flex;gap:18px;align-items:center;font-family:"IBM Plex Mono",monospace;font-size:10px;color:var(--home-muted);text-transform:uppercase;letter-spacing:.04em}

  const works = [...section.querySelectorAll("[data-reel-work]")];
  const captions = [...section.querySelectorAll("[data-reel-caption]")];
  const letters = [...section.querySelectorAll("[data-reel-letter]")];
  const progress = document.getElementById(ids.progress);
  const idxEl = document.getElementById(ids.idx);
  const catEl = document.getElementById(ids.cat), clientEl = document.getElementById(ids.client);

@media(max-width:900px){.usersStage{height:auto;display:flex;flex-direction:column;gap:18px;align-items:center}.uCard{position:relative !important;left:auto !important;right:auto !important;top:auto !important;bottom:auto !important;width:min(100%,396px) !important;transform:none !important}}

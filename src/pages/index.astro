    dot.style.top = (p.y / 3360 * 100) + "%";
    stops.forEach((s, i) => {
      s.classList.toggle("on", drawn >= stopLen[i] - 420);
      s.classList.toggle("lit", drawn >= stopLen[i] - 30);
    });
  };
  const measure = () => {
    const r = stage.getBoundingClientRect();
    const centerY = (innerHeight * 0.52 - r.top) / (r.height / 3360);
    target = targetForCenterY(centerY);
  };
  const tick = () => {
    if (live) {
      measure();
      drawn += (target - drawn) * 0.2;
      if (Math.abs(target - drawn) < 0.4) drawn = target;
      render();
    }
    requestAnimationFrame(tick);
  };
  new IntersectionObserver((es) => es.forEach((e) => { live = e.isIntersecting; }), { rootMargin: "60% 0px" }).observe(stage);
  render();
  requestAnimationFrame(tick);
})();
</script>
<script>
(() => {
  const sec = document.querySelector("#home-mainfeature");
  if (!sec) return;
  const rows = [...sec.querySelectorAll("[data-mx-row]")];
  const bigN = sec.querySelector("[data-mx-bign]");
  const bigName = sec.querySelector("[data-mx-bigname]");
  const swap = sec.querySelector("[data-mx-swap]");
  const segs = [...sec.querySelectorAll("[data-mx-seg]")];
  const title = sec.querySelector("[data-mx-title]");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }), { threshold: 0.2 });
  rows.forEach((r) => io.observe(r));
  const ioT = new IntersectionObserver(([e]) => { if (e.isIntersecting) { title.classList.add("in"); ioT.disconnect(); } }, { threshold: 0.4 });
  ioT.observe(title);
  let active = -1, swapToken = 0, ticking = false;
  function setActive(i) {
    if (i === active) return;
    active = i;
    rows.forEach((r, k) => r.classList.toggle("active", k === i));
    const r = rows[i];
    const apply = () => { bigN.textContent = r.dataset.n; bigN.style.color = r.dataset.color; bigName.textContent = r.dataset.name; swap.classList.remove("out"); };
    if (reduced) apply();
    else { const tk = ++swapToken; swap.classList.add("out"); setTimeout(() => { if (tk === swapToken) apply(); }, 170); }
    segs.forEach((s, k) => { s.style.background = k <= i ? rows[k].dataset.color : ""; });
  }
  function probe() {
    ticking = false;
    const mid = innerHeight * 0.5;
    let best = 0, bd = Infinity;
    rows.forEach((r, i) => { const rc = r.getBoundingClientRect(); const d = Math.abs(rc.top + rc.height / 2 - mid); if (d < bd) { bd = d; best = i; } });
    setActive(best);
  }
  const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(probe); } };
  addEventListener("scroll", onScroll, { passive: true });
  addEventListener("resize", onScroll);
  probe();
})();
</script>
<script>
(() => {
  const sec = document.querySelector("#home-sitemap");
  if (!sec) return;
  const stage = sec.querySelector("[data-sm-stage]");
  const lines = [...sec.querySelectorAll("[data-sm-line]")].map((p) => ({ p, len: p.getTotalLength(), w: p.dataset.smLine.split(",").map(Number), key: p.dataset.smSpine || null }));
  lines.forEach(({ p, len }) => { p.style.strokeDasharray = len; p.style.strokeDashoffset = len; });
  const dots = { pub: sec.querySelector("[data-sm-dot='pub']"), priv: sec.querySelector("[data-sm-dot='priv']") };
  const onEls = [...sec.querySelectorAll("[data-sm-on]")];
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const title = sec.querySelector("[data-sm-title]");
  const ioR = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); ioR.unobserve(e.target); } }), { threshold: 0.3 });
  sec.querySelectorAll("[data-sm-reveal]").forEach((el) => ioR.observe(el));
  const ioT = new IntersectionObserver(([e]) => { if (e.isIntersecting) { title.classList.add("in"); ioT.disconnect(); } }, { threshold: 0.4 });
  ioT.observe(title);
  let cur = 0, running = false;
  const localOf = (l) => Math.min(1, Math.max(0, (cur - l.w[0]) / (l.w[1] - l.w[0])));
  function render() {
    for (const l of lines) {
      const local = localOf(l);
      l.p.style.strokeDashoffset = (l.len * (1 - local)).toFixed(1);
      if (l.key && dots[l.key]) {
        const g = dots[l.key];
        if (local > 0 && local < 1) { const pt = l.p.getPointAtLength(l.len * local); g.setAttribute("transform", `translate(${pt.x} ${pt.y})`); g.setAttribute("opacity", "1"); }
        else g.setAttribute("opacity", "0");
      }
    }
    onEls.forEach((el) => { if (cur >= parseFloat(el.dataset.smOn)) el.classList.add("on"); });
  }
  function tick() {
    const r = sec.getBoundingClientRect();
    const target = Math.min(1, Math.max(0, (innerHeight * 0.95 - r.top) / (r.height * 0.85)));
    cur += (target - cur) * 0.16;
    if (Math.abs(target - cur) < 0.001) cur = target;
    render();
    if (running) requestAnimationFrame(tick);
  }
  if (reduced) { cur = 1; render(); }
  else new IntersectionObserver(([e]) => { if (e.isIntersecting) { if (!running) { running = true; requestAnimationFrame(tick); } } else running = false; }, { rootMargin: "25% 0px" }).observe(sec);
})();
</script>
<script>
(() => {
  const sec = document.querySelector("#home-closing");
  if (!sec) return;
  const title = sec.querySelector("[data-cl-title]");
  const ioT = new IntersectionObserver(([e]) => { if (e.isIntersecting) { title.classList.add("in"); ioT.disconnect(); } }, { threshold: 0.4 });
  ioT.observe(title);
  const ioR = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); ioR.unobserve(e.target); } }), { threshold: 0.25 });
  sec.querySelectorAll("[data-cl-reveal]").forEach((el) => ioR.observe(el));
})();
</script>
<script>
(() => {
  const sec = document.querySelector("#home-userflow");
  if (!sec) return;
  const stage = sec.querySelector("[data-uf-stage]");
  const line = sec.querySelector("[data-uf-line]");
  const len = line.getTotalLength();
  line.style.strokeDasharray = len;
  line.style.strokeDashoffset = len;
  const dot = sec.querySelector("[data-uf-dot]");
  const onEls = [...sec.querySelectorAll("[data-uf-on]")];
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const title = sec.querySelector("[data-uf-title]");
  const ioT = new IntersectionObserver(([e]) => { if (e.isIntersecting) { title.classList.add("in"); ioT.disconnect(); } }, { threshold: 0.4 });
  ioT.observe(title);
  const ioR = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); ioR.unobserve(e.target); } }), { threshold: 0.3 });
  sec.querySelectorAll("[data-uf-reveal]").forEach((el) => ioR.observe(el));
  let cur = 0, running = false;
  function render() {
    const local = Math.min(1, Math.max(0, cur / 0.8));
    line.style.strokeDashoffset = (len * (1 - local)).toFixed(1);
    if (local > 0 && local < 1) { const pt = line.getPointAtLength(len * local); dot.setAttribute("transform", `translate(${pt.x} ${pt.y})`); dot.setAttribute("opacity", "1"); }
    else dot.setAttribute("opacity", "0");
    onEls.forEach((el) => { if (cur >= parseFloat(el.dataset.ufOn)) el.classList.add("on"); });
  }
  function tick() {
    const r = stage.getBoundingClientRect();
    const target = Math.min(1, Math.max(0, (innerHeight * 0.9 - r.top) / (r.height * 0.75)));
    cur += (target - cur) * 0.16;
    if (Math.abs(target - cur) < 0.001) cur = target;
    render();
    if (running) requestAnimationFrame(tick);
  }
  if (reduced) { cur = 1; render(); }
  else new IntersectionObserver(([e]) => { if (e.isIntersecting) { if (!running) { running = true; requestAnimationFrame(tick); } } else running = false; }, { rootMargin: "25% 0px" }).observe(sec);
})();
</script>

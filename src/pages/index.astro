.iaTitle{margin-top:18px;font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:clamp(56px,7.4vw,116px);line-height:.98;letter-spacing:-.032em;color:var(--home-ink)}
.iaEnding{display:block;font-family:Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.01em}

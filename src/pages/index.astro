/* ---------- main feature: the index ---------- */
#home-mainfeature{background:var(--home-paper);color:var(--home-ink);position:relative;padding:clamp(84px,9vw,132px) var(--gutter);overflow:clip}
.mxLead{max-width:1240px;margin:0 auto;position:relative}
.mxGhost{position:absolute;top:-44px;right:-6px;font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:clamp(140px,16vw,230px);line-height:1;color:transparent;-webkit-text-stroke:1px rgb(19 19 19/.10);pointer-events:none}
.mxEyebrow{font-size:17px;color:var(--home-muted);margin-bottom:20px;position:relative}
.mxTitle{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:clamp(56px,7vw,116px);letter-spacing:-.035em;line-height:1;position:relative}

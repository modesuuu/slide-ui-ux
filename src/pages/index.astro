.reelCaption p span+span{border-left:1px solid var(--home-rule);padding-left:18px}
.reelCaption .open{font-size:34px;line-height:1;flex:none;margin-top:-6px}
.reelControls{position:absolute;left:var(--gutter);right:var(--gutter);bottom:clamp(25px,4.5vh,48px);z-index:5;display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:24px}
.reelReadout{display:flex;align-items:center;gap:15px;font-family:"IBM Plex Mono",monospace}
.reelReadout .cur{font-size:25px;letter-spacing:-.06em;font-variant-numeric:tabular-nums;line-height:1}
.reelReadout .tot{font-size:11px;color:var(--home-muted)}
.reelReadout svg{width:clamp(60px,10vw,164px);height:24px}
.reelHint{font-family:"IBM Plex Mono",monospace;font-size:10px;color:var(--home-muted);display:flex;gap:20px;align-items:center;line-height:1.5}
.reelHint span{color:var(--home-ink);font-size:26px}

// Clean-room rebuild of anubi.io homepage sections 1-3 (study clone).
// All code is original; animation mechanics/values come from the REA
// inspection report (~/workspace/rea-anubi/laporan-anubi-section-1-3.md).
// Project artwork is replaced by labelled gradient posters (no original assets).
const projects = [
  { title: "Underflow — Work, together.", cat: "UI/UX Design", client: "Underflow", g: "linear-gradient(135deg,#0f2027,#203a43 55%,#2c5364)", tilt: -3 },
  { title: "Collaborations — Find your team", cat: "Core Feature", client: "Underflow", g: "linear-gradient(135deg,#f83600,#f9d423)", tilt: 2 },
  { title: "User Research — Survey & Findings", cat: "Research", client: "Underflow", g: "linear-gradient(135deg,#11998e,#38ef7d)", tilt: -4 },
  { title: "Affinity Mapping — Four clusters", cat: "Research", client: "Underflow", g: "linear-gradient(135deg,#396afc,#2948ff)", tilt: 5 },
  { title: "Circle — A room for every project", cat: "Key Feature", client: "Underflow", g: "linear-gradient(135deg,#ff9a9e,#fecfef)", tilt: -2 },
  { title: "Target Users — Five profiles", cat: "Research", client: "Underflow", g: "linear-gradient(135deg,#cb2d3e,#ef473a)", tilt: 3 },
  { title: "The Feed — Share your work", cat: "Feature", client: "Underflow", g: "linear-gradient(135deg,#56ab2f,#a8e063)", tilt: -5 },
  { title: "Problem & Background", cat: "Research", client: "Underflow", g: "linear-gradient(135deg,#134e5e,#71b280)", tilt: 4 },
  { title: "Information Architecture", cat: "UX Structure", client: "Underflow", g: "linear-gradient(135deg,#89f7fe,#66a6ff)", tilt: -3 },
  { title: "User Flow — Apply, approve, join", cat: "UX Flow", client: "Underflow", g: "linear-gradient(135deg,#ee9ca7,#ffdde1)", tilt: 2 },
  { title: "My Collaborations — Your desk", cat: "Feature", client: "Underflow", g: "linear-gradient(135deg,#eacda3,#d6ae7b)", tilt: -4 },
  { title: "Solution & Key Features", cat: "Product", client: "Underflow", g: "linear-gradient(135deg,#232526,#414345)", tilt: 5 }
];
const clients = ["Underflow","Collaborations","Circle","The Feed","User Research","Affinity Mapping","Information Architecture","User Flow","TechnoSpark"];
const featured = [
  { title: "Difficulty forming a team. Students struggle to find a partner who fits the project, have ended up with members whose skills did not match, and cannot find specific roles the team needs", label: "Finding 01", cat: "Research Findings & Affinity Mapping", client: "Finding 01", art: "01", g: "linear-gradient(135deg,#1d4ed8,#2878f0 55%,#38bdf8)" },
  { title: "Skill and role fit. Information about a person’s skills and abilities is not easy to find, so judging whether someone fits is guesswork", label: "Finding 02", cat: "Research Findings & Affinity Mapping", client: "Finding 02", art: "02", g: "linear-gradient(135deg,#c2410c,#ff7415 55%,#ffb347)" },
  { title: "The search process. Students look through friends, group chats, communities, and social media, and the search takes time and effort.", label: "Finding 03", cat: "Research Findings & Affinity Mapping", client: "Finding 03", art: "03", g: "linear-gradient(135deg,#5b21b6,#8060f5 55%,#c4b5fd)" },
  { title: "The search process. Students look through friends, group chats, communities, and social media, and the search takes time and effort.", label: "Finding 04", cat: "Research Findings & Affinity Mapping", client: "Finding 04", art: "04", g: "linear-gradient(135deg,#3f6212,#69a816 55%,#a8e063)" }
];
const MEMBER_SLOTS = {
  0: { name: "Raka Alfarezi", role: "UI/UX · Frontend Dev", img: "/members/raka.jpg" },
  2: { name: "Alifah Syarifah", role: "Research", img: "/members/alifah.jpg" },
  5: { name: "Alvina Putri", role: "Research", img: "/members/alvina.jpg" },
  7: { name: "Fadilah Yasin", role: "Asst. Backend · Database", img: "/members/fadilah.jpg" },
  10: { name: "Faiz Aghitsna", role: "Backend · Database", img: "/members/faiz.jpg" },
};
const initials = (t) => t.split(" ").filter(Boolean).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
const sculptSpinePath = (() => {
  const pts = [];
  for (let r = 0; r <= 80; r++) {
    const t = (r / 80) * Math.PI * 2;
    const x = 68 * (Math.sin(t) + 2 * Math.sin(2 * t)), y = 68 * (Math.cos(t) - 2 * Math.cos(2 * t)), z = -55 * Math.sin(3 * t);
    const u = 0.94 * x + 0.34 * z, v = 0.94 * y - 0.34 * z;
    pts.push(`${r ? "L" : "M"}${(320 + u * 0.97 - v * 0.24).toFixed(2)},${(258 + u * 0.24 + v * 0.97).toFixed(2)}`);
  }
  return pts.join(" ");
})();
const userCards = [
  { variant: "black", posCls: "uPos1", w: 358, icon: "users", title: "Target users", body: "Students \u00b7 School students \u00b7 Teachers \u00b7 Software Engineers \u00b7 IT Practitioners" },
  { variant: "violet", posCls: "uPos2", w: 371, icon: "search", title: "user needs", body: "Partners who fit the project: the right skill, the right role, a real interest in the field \u00b7 Information you can see before deciding: what a person can do, and what a project needs \u00b7 One central place to search" },
  { variant: "default", posCls: "uPos3", w: 396, icon: "bolt", title: "Pain point", body: "The search is scattered across friends, group chats, communities, and social media \u00b7 Skills stay invisible until the work has started \u00b7 Finding a collaborator takes time and effort" },
];
const cardIcons = {
  users: '<circle cx="9" cy="8.2" r="3.3"/><path d="M3.6 19.2c.7-3.1 2.8-4.7 5.4-4.7s4.7 1.6 5.4 4.7"/><circle cx="17.2" cy="9.2" r="2.5"/><path d="M16.6 14.7c1.9.2 3.2 1.6 3.7 3.9"/>',
  search: '<circle cx="11" cy="11" r="6.6"/><path d="M15.8 15.8 20.6 20.6"/>',
  bolt: '<path d="M13.4 3 5.6 13.4h5.2L9.4 21l7.9-10.4h-5.2l1.3-7.6Z"/>',
};
const journeyStops = [
  { name: "Objectives", full: "Research Objectives", dummy: "/dummies/dummy-1.jpg", ax: 395, ay: 330, color: "#2878f0", doodle: "asterisk", bullets: ["Understand challenges in forming project teams.", "Identify difficulties in finding suitable collaborators.", "Explore students\u2019 collaboration needs."] },
  { name: "Methods", full: "Research Methods", dummy: "/dummies/dummy-2.jpg", ax: 880, ay: 1180, color: "#ff7415", doodle: "spiral", bullets: ["Questionnaire survey to collect students\u2019 experiences and challenges.", "Observation to understand project collaboration practices, if conducted."] },
  { name: "Participants", full: "Research Participants", dummy: "/dummies/dummy-3.jpg", ax: 402, ay: 2032, color: "#8060f5", doodle: "star", bullets: ["20 student respondents.", "Participants from different faculties.", "Most respondents were in their first or second semester."] },
  { name: "Evidence", full: "Research Evidence", dummy: "/dummies/dummy-4.jpg", ax: 890, ay: 2882, color: "#69a816", doodle: "loop", bullets: ["Questionnaire documentation.", "Survey response summary.", "Supporting research documentation."] },
];
const journeyDoodles = {
  asterisk: '<svg data-home-sketch="draw" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M24 5 L24 43 M7.5 14.5 L40.5 33.5 M40.5 14.5 L7.5 33.5" stroke-width="4" stroke-linecap="round"/></svg>',
  spiral: '<svg data-home-sketch="draw" viewBox="0 0 60 46" fill="none" aria-hidden="true"><path d="M6 34 C 4 14, 26 4, 40 10 C 54 16, 52 34, 38 38 C 26 41, 18 30, 26 22" stroke-width="4" stroke-linecap="round"/></svg>',
  star: '<svg class="jDoodleStar" data-home-sketch="rotate" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M24 3 C26 15, 30 19, 43 21 C30 23, 26 27, 24 39 C22 27, 18 23, 5 21 C18 19, 22 15, 24 3 Z"/></svg>',
  loop: '<svg data-home-sketch="draw" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M24 6 C 38 4, 45 16, 43 27 C 41 39, 29 45, 19 41 C 8 37, 5 24, 11 15 C 16 8, 27 6, 33 11" stroke-width="3.5" stroke-linecap="round"/></svg>',
};
const featuredInsights = [
  { title: "Team formation is still one of the main obstacles in project work", label: "Insight 1", cat: "Key Insights", client: "Insight 1", art: "01", g: "linear-gradient(155deg,#172554,#1d4ed8 60%,#2878f0)" },
  { title: "Users need clear information about abilities to judge whether a collaborator fits", label: "Insight 2", cat: "Key Insights", client: "Insight 2", art: "02", g: "linear-gradient(155deg,#7c2d12,#ea580c 60%,#ff7415)" },
  { title: "There is no central, practical way to search for collaborators yet", label: "Finding 03", cat: "Key Insights", client: "Finding 03", art: "03", g: "linear-gradient(155deg,#4c1d95,#7c3aed 60%,#8060f5)" },
  { title: "A platform is needed that supports finding and collaborating by skill, role, and interest.", label: "Finding 04", cat: "Key Insights", client: "Finding 04", art: "04", g: "linear-gradient(155deg,#1a2e05,#4d7c0f 60%,#69a816)" },
];
const groups = [
  { key: "problem", label: "Problem Statement", color: "#2878f0", items: ["Skill", "Role", "Interest"], pos: "left:30%;top:20%", body: "Users struggle to find collaborators who fit a project's needs, especially in skill, role, and interest. They have ended up with members whose skills did not match, and some roles are simply hard to fill." },
  { key: "situation", label: "Current Situation", color: "#ff7415", items: ["Asking friends", "Posting in group chats", "Scrolling communities", "Messaging people on social media"], pos: "left:66%;top:47%", body: "" },
  { key: "impact", label: "Impact", color: "#8060f5", items: [], pos: "left:36%;top:82%", body: "The cost is time lost before the work even begins, and teams that start with the wrong people." },
];

const featSteps = [
  { n: "01", name: "Browse & Search", color: "#2878f0", doodle: "asterisk", desc: "Every open collaboration in one list, searchable by skill, role, and interest." },
  { n: "02", name: "Apply & Approve", color: "#ff7415", doodle: "spiral", desc: "Joining a team is a decision, not a DM. Owners approve who comes in" },
  { n: "03", name: "The Circle", color: "#8060f5", doodle: "star", desc: "Every approved collaboration gets a private team space: channels, members, zero strangers" },
  { n: "04", name: "Resources", color: "#69a816", doodle: "loop", desc: "Files, links, and decisions pinned where the whole team can find them" },
  { n: "05", name: "Collaborations", color: "#69a816", doodle: "astel", ink: true, desc: "Post a collaboration, or join one. Real projects, real teams, real work" },
];
const featStar = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1.5c.8 6.1 2.4 8.9 10.5 10.5C14.4 13.6 12.8 16.4 12 22.5c-.8-6.1-2.4-8.9-10.5-10.5C9.6 10.4 11.2 7.6 12 1.5Z"/></svg>';


---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Underflow — UI/UX Presentation</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Epilogue:wght@400;450;500;600;700&family=Bricolage+Grotesque:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
<style>
:root{
  --ink:#131313; --paper:#fcfcfa; --home-paper:#fcfcfa; --home-ink:#131313; --home-muted:#62625c; --home-rule:#d9d9d3;
  --blue:#2878f0; --orange:#ff7415; --violet:#8060f5;
  --gutter:clamp(24px,3.2vw,64px);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:auto}
html.lenis,html.lenis body{height:auto}
.lenis.lenis-smooth{scroll-behavior:auto!important}
body{font-family:"Epilogue",system-ui,sans-serif;background:var(--paper);color:var(--ink);overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
.srOnly{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* ---------- preloader ---------- */
#preloader{position:fixed;inset:0;z-index:200;background:#0c0c0c;display:grid;place-items:center;clip-path:circle(150% at 50% 50%)}
#preloader .bootCircle{width:190px;height:190px;border-radius:50%;background:#fcfcfa;display:grid;place-items:center;text-align:center;position:relative}
#preloader .bootCircle b{font-family:"Bricolage Grotesque",sans-serif;font-size:30px;letter-spacing:.02em;display:block}
#preloader .bootCircle span{font-size:10.5px;opacity:.65;display:block;margin-top:5px;padding:0 22px;line-height:1.45}
#preloader .spin{position:absolute;inset:-16px;border-radius:50%;border:2px dashed var(--violet);animation:spin 7s linear infinite}
#preloader .arc{position:absolute;inset:-16px;transform:rotate(-30deg)}
#preloader p{position:absolute;bottom:34px;left:0;right:0;text-align:center;color:#fcfcfa;font-size:12px;letter-spacing:.14em;text-transform:uppercase;opacity:.75}
@keyframes spin{to{transform:rotate(360deg)}}

/* ---------- header pill ---------- */

/* ---------- hero ---------- */
.hero{--hero-paper:var(--paper);background:var(--hero-paper);min-height:max(700px,100dvh);overflow:hidden;position:relative;isolation:isolate}
.orbitStage{position:absolute;inset:88px 0 116px;container-type:size;touch-action:pan-y;user-select:none}
.pointerInk{position:absolute;inset:0;z-index:5;pointer-events:none}
.orbitCard{position:absolute;left:0;top:0;width:min(10.9375cqw,23.3333cqh,280px);aspect-ratio:1.6;will-change:transform}
.orbitCard .cardInner{position:absolute;inset:0;display:block;transition:transform .55s cubic-bezier(.16,1,.3,1)}
.orbitCard:hover .cardInner,.orbitCard:focus-within .cardInner{transform:translateY(-8px) scale(1.1)}
.orbitCard .cardMedia{position:absolute;inset:0;border-radius:12px;overflow:hidden;background:#e8e8e4;box-shadow:0 1px 2px rgb(26 26 24/8%),0 calc(9px + var(--card-depth,0)*15px) calc(18px + var(--card-depth,0)*20px) -12px rgb(26 26 24/calc(.12 + var(--card-depth,0)*.12))}
.orbitCard .cardMedia::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgb(255 255 255/.08) 1px,transparent 1px),linear-gradient(90deg,rgb(255 255 255/.08) 1px,transparent 1px);background-size:26px 26px}
.orbitCard .cardMedia::after{content:"";position:absolute;inset:0;background:radial-gradient(120% 90% at 20% 0%,rgb(255 255 255/.35),transparent 55%)}
.orbitCard .cardMedia .pArt{position:absolute;right:-4px;bottom:-13px;font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:58px;line-height:1;letter-spacing:-.04em;color:rgb(255 255 255/.30)}
.orbitCard .cap{position:absolute;inset:100% 0 auto;z-index:2;background:var(--paper);color:var(--ink);display:flex;justify-content:space-between;gap:16px;font-size:14px;font-weight:550;line-height:1.25;padding:10px 1px;opacity:0;transform:translateY(-4px);transition:opacity .18s ease,transform .28s cubic-bezier(.16,1,.3,1)}
.orbitCard:hover .cap,.orbitCard:focus-within .cap{opacity:1;transform:translateY(0)}
.orbitCard .memberMedia{background:#fff}
.orbitCard .memberPhoto{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 18%}
.orbitCard.member .cap{font-size:13px}
.orbitCard.member .cap small{font-size:10.5px}
.orbitCard .cap small{font-weight:400;color:#62625c;font-size:12.5px;text-align:right}
.heroIdentity{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:15;width:min(62cqw,1250.8px);aspect-ratio:1000/550;display:flex;flex-direction:column;justify-content:center;pointer-events:none}
.wordmark{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:7.6cqw;line-height:.95;letter-spacing:-.03em;display:flex;align-items:center;justify-content:center;gap:.14em;width:fit-content;margin:0 auto;animation:wordmark-arrive .9s cubic-bezier(.16,1,.3,1) .3s backwards}
.wordmark .wmMark{height:.6em;width:auto;display:block;flex:none}
.wordmark .wmText{display:block}
@keyframes wordmark-arrive{0%{opacity:0;transform:translateY(18px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
.sketchLayer{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}
.sketchLayer[data-sketch-plane="back"]{z-index:1}
.sketchLayer[data-sketch-plane="front"]{z-index:3}
.wordmark{position:relative;z-index:2}
.heroFooter{position:absolute;left:0;right:0;bottom:28px;z-index:50;display:flex;justify-content:space-between;align-items:flex-end;padding:0 var(--gutter)}
.heroFooter .statement{font-size:clamp(22px,2vw,30px);font-weight:500;line-height:1.06;letter-spacing:-.045em}
.heroFooter .statement span{color:#6c6c66}
.exploreLink{display:flex;flex-direction:column;align-items:flex-end;gap:2px;font-weight:700;font-size:15px}
.exploreLink .arr{font-size:21px}
</style>
</head>
<body>
<style>
/* ---------- clients ---------- */
#home-clients{background:var(--paper);padding:8px var(--gutter) 30px}
.partners{display:flex;flex-wrap:wrap;gap:1px;background:rgb(0 0 0/.05);border:1px solid rgb(0 0 0/.05)}
.partners div{background:var(--paper);min-height:120px;padding:28px 34px;display:grid;place-items:center;flex:1 1 auto}
.partners span{font-weight:700;font-size:18px;letter-spacing:.02em;white-space:nowrap;filter:grayscale(100%);opacity:.34;animation:logoWave 14s ease-in-out infinite}
.partners div:nth-child(2) span{animation-duration:17s;animation-delay:-4s}
.partners div:nth-child(3) span{animation-duration:12s;animation-delay:-2s}
.partners div:nth-child(4) span{animation-duration:19s;animation-delay:-7s}
.partners div:nth-child(5) span{animation-duration:15s;animation-delay:-9s}
.partners div:nth-child(6) span{animation-duration:11s;animation-delay:-1s}
.partners div:nth-child(7) span{animation-duration:18s;animation-delay:-5s}
.partners div:nth-child(8) span{animation-duration:13s;animation-delay:-8s}
.partners div:nth-child(9) span{animation-duration:20s;animation-delay:-3s}
.partners div:nth-child(10) span{animation-duration:16s;animation-delay:-6s}
@keyframes logoWave{0%,100%{opacity:.30}12%{opacity:.5}28%{opacity:.38}45%{opacity:.62}60%{opacity:.4}78%{opacity:.55}}

/* ---------- services ---------- */
#home-services{background:var(--home-paper);color:var(--home-ink);padding:clamp(48px,4vw,72px) var(--gutter) 24px;overflow:hidden}
.services{display:grid;grid-template-columns:minmax(0,1fr) min(54%,620px) min(46%,480px) minmax(0,1fr);max-width:none;margin:0}
.introduction{grid-column:1/-1;text-align:center;padding-block:8px 32px}
@media(max-width:900px){.services{display:block}.introduction{padding-block:0 8px}}
.manifesto{display:contents}
.headline{font-family:"Bricolage Grotesque",sans-serif;white-space:nowrap;font-size:clamp(54px,6.4vw,108px);font-weight:500;line-height:1.08;letter-spacing:-.07em}
.headline .ending{position:relative;white-space:nowrap}
.headline .underline{position:absolute;left:0;bottom:-.14em;width:100%;height:.3em;overflow:visible}
.introCopy{margin:30px auto 0;font-size:16px;line-height:1.65;max-width:59ch;font-weight:400;color:var(--home-muted)}
.visual{position:relative;grid-column:2;grid-row:2;align-self:center;min-width:0}
.visual .artwork{opacity:.42}
.pointDetail{position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);z-index:3;padding:0 7%;text-align:center}
.pointBlock h4{font-family:"IBM Plex Mono",monospace;font-size:12px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--home-muted)}
.pointBlock p{margin-top:10px;font-size:18px;line-height:1.6;color:var(--home-ink);max-width:46ch;margin-inline:auto}
.pointBlock ul{margin-top:10px;list-style:none;display:grid;gap:8px}
.pointBlock li{font-size:17.5px;line-height:1.4;position:relative}
.pointBlock li::before{content:"";display:inline-block;margin-right:9px;width:8px;height:8px;border-radius:50%;background:#A1FF26;vertical-align:2px}
.visual .star{position:absolute;top:-14px;right:6%;width:54px;height:54px;z-index:2}
.artwork{position:relative;width:100%;aspect-ratio:640/520;color:var(--home-ink)}
.sculptFallback{position:absolute;inset:0;width:100%;height:100%}
.artwork[data-canvas-ready="true"] .sculptFallback{visibility:hidden}
.artwork canvas{position:relative}
.artwork canvas{width:100%;height:100%;display:block}
.constellation{position:relative;grid-column:3;grid-row:2;align-self:center;height:clamp(440px,30vw,520px);container-type:inline-size}
@media(max-width:900px){.constellation{height:430px;margin-top:8px}}
.discNode{position:absolute;width:76%;max-width:380px;height:168px;transform:translate(-50%,-50%)}
.nodeMagnet{will-change:transform}
.nodeFloat{animation:nodeDrift 7s ease-in-out infinite alternate paused;height:100%;display:grid;place-items:center;position:relative}
.services[data-playing="true"] .nodeFloat{animation-play-state:running}
.discNode:nth-child(2) .nodeFloat{animation-duration:9s;animation-delay:-5s}
.discNode:nth-child(3) .nodeFloat{animation-duration:8s;animation-delay:-3s}
@keyframes nodeDrift{0%{transform:translate3d(-10px,9px,0) rotate(-1.5deg)}to{transform:translate3d(10px,-12px,0) rotate(1.5deg)}}
.discName{font-family:"Bricolage Grotesque",sans-serif;font-size:clamp(33px,7.6cqw,56px);font-weight:500;letter-spacing:-.065em;line-height:1.1;background:none;border:0;cursor:pointer;padding:8px 6px 12px;color:var(--home-ink);transition:color .65s cubic-bezier(.22,1,.36,1)}
.discNode[data-active="true"] .discName{color:var(--ac)}
.discName:focus-visible{outline:2px solid var(--ac);outline-offset:5px;border-radius:10px}
.satellites{list-style:none;position:absolute;inset:0;margin:0;padding:0;pointer-events:none}
.satellites li{position:absolute;left:50%;top:50%;font-family:"IBM Plex Mono",monospace;font-size:clamp(11.5px,2.3cqw,14px);color:var(--home-muted);text-align:center;max-width:17ch;line-height:1.35;opacity:0;transform:translate(-50%,-50%) scale(.55);transition:opacity .4s ease,transform .55s cubic-bezier(.16,1,.3,1);transition-delay:calc(var(--o)*35ms)}
.satellites li:nth-child(1){--sx:-24cqw;--sy:-80px}
.satellites li:nth-child(2){--sx:21cqw;--sy:-74px}
.satellites li:nth-child(3){--sx:-18cqw;--sy:84px}
.satellites li:nth-child(4){--sx:24cqw;--sy:76px}
.discNode:not([data-service-node="problem"]) .satellites li:nth-child(3){--sx:2cqw;--sy:88px}
.discNode[data-service-node="problem"] .satellites li:nth-child(1){--sy:-62px}
.discNode[data-service-node="problem"] .satellites li:nth-child(2){--sy:-58px}

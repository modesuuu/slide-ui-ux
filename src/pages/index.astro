/* ================= IN EVIDENZA — spatial reel (math verbatim from inspection, module 57462) ================= */
const ASPECT = 16 / 9, JL = 6, FOV = 40;
const clampN = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v));
const smooth = (e1, e2, x) => { const t = clampN((x - e1) / (e2 - e1)); return t * t * (3 - 2 * t); };
function reelMetrics(w, h) {
  const mobile = w < 780;
  const fh = Math.min(0.54 * h, (w * (mobile ? 0.9 : 0.72)) / ASPECT);
  const worldH = 2 * Math.tan((FOV * Math.PI) / 360) * JL;
  return { mobile, frameHeight: fh, frameWidth: fh * ASPECT, worldHeight: worldH, worldWidth: (worldH * w) / h, unit: worldH / h };
}
function workOffset(d, m) {
  const { worldWidth: r, worldHeight: a } = m, n = Math.max(0, d), s = Math.max(0, -d);
  return {
    x: d >= 0 ? Math.sin(1.1 * n) * r * 0.74 : -0.814 * r * s * (1 + 0.12 * s),
    y: d >= 0 ? Math.sin(0.95 * n) * a * 0.2 : -0.2 * a * Math.sin(0.95 * s) * (1 + 0.3 * s),
